package com.taller.backend.repository;

import java.time.LocalDateTime;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;

import com.taller.backend.entity.Factura;

public interface FacturaRepository extends JpaRepository<Factura, Long> {

    // Contar número de facturas en un rango de fechas para un empleado
    long countByIdEmpleadoAndFechaBetween(
            Long idEmpleado,
            LocalDateTime inicio,
            LocalDateTime fin
    );

    // Sumar total facturado en un rango de fechas para un empleado
    @Query("""
        SELECT COALESCE(SUM(f.total), 0)
        FROM Factura f
        WHERE f.idEmpleado = :idEmpleado
        AND f.fecha BETWEEN :inicio AND :fin
    """)
    Integer sumTotalByIdEmpleadoAndFechaBetween(
            @Param("idEmpleado") Long idEmpleado,
            @Param("inicio") LocalDateTime inicio,
            @Param("fin") LocalDateTime fin
    );
}